# ============================================================
# CareFlowAI frontend — environment variables (Vite)
# Copy this file to `.env` and fill in real values.
# ============================================================

# Base URL of the backend API.
# Leave EMPTY in development to route /api through the Vite dev proxy.
# In production set it to the deployed backend origin (no trailing slash):
# VITE_API_URL=https://careflowai-backend.onrender.com
VITE_API_URL=

# Public base URL encoded into patient QR codes. Must be the URL where the
# frontend is actually hosted so scanned QR codes open the tracking page.
# Local: http://localhost:5173 (or your LAN IP for phone testing)
# Production: https://your-app.vercel.app
VITE_PUBLIC_URL=http://localhost:5173

# ---- Firebase Client Configuration (Google OAuth) ----
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
