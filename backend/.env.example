# ============================================================
# CareFlowAI backend — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ============================================================

# ---- Server ----
# Render injects PORT automatically; 5000 is the local default.
PORT=5000

# ---- Database ----
# Local development:
MONGO_URI=mongodb://localhost:27017/careflowai
# Production (MongoDB Atlas) — uncomment and fill in:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/careflowai?retryWrites=true&w=majority

# ---- Security ----
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# ---- CORS allow-list (comma-separated origins) ----
# Leave UNSET during local development to allow all origins (dev fallback).
# Local + phone-on-same-Wi-Fi test:
# FRONTEND_URL=http://localhost:5173,http://192.168.1.15:5173
# Production:
# FRONTEND_URL=https://your-app.vercel.app

# ---- Firebase Admin Authentication (Google OAuth) ----
# Provide either your Firebase project ID, or full service account credentials:
FIREBASE_PROJECT_ID=
# Optional when using individual service account credentials:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Or path/JSON string to your serviceAccountKey.json:
# FIREBASE_SERVICE_ACCOUNT=
